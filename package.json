{
  "name": "receitasapi-e2e",
  "private": true,
  "scripts": {
    "e2e": "npm --prefix receitasapi-ui run test:playwright",
    "test:playwright": "npm --prefix receitasapi-ui run test:playwright",
    "flow:mealplan": "npm --prefix receitasapi-ui run test:playwright -- --config playwright.config.ts tests/meal-plan.spec.ts",
    "sonar:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sonar-setup.ps1",
    "sonar:setup:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sonar-setup.ps1 -Reset",
    "sonar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sonar-run.ps1",
    "sonar:down": "docker compose --profile sonar down -v",
    "sonar:open": "powershell -NoProfile -Command \"Start-Process 'http://localhost:9000'\"",
    "sonar:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sonar-run.ps1 -OpenDashboard"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.60.0"
  }
}
