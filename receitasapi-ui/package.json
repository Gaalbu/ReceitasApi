{
  "name": "receitasapi-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node ./scripts/test.mjs",
    "sonar": "npm --prefix .. run sonar",
    "sonar:down": "npm --prefix .. run sonar:down",
    "sonar:open": "npm --prefix .. run sonar:open",
    "sonar:all": "npm --prefix .. run sonar:all",
    "serve:ssr:receitasapi-frontend": "node dist/receitasapi-frontend/server/server.mjs",
    "playwright:install": "npx playwright install --with-deps",
    "test:playwright": "npx playwright test",
    "test:coverage": "ng test --coverage --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/ssr": "^22.1.8",
    "@vitest/browser-playwright": "^4.1.7",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.7",
    "aislop": "^0.16.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
